# Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values
# Never commit .env files with real credentials to version control

# Memegenerator API credentials
MEMEGENERATOR_USERNAME=your_memegenerator_username_here
MEMEGENERATOR_PASSWORD=your_memegenerator_password_here

# Zotero Web API credentials
# Create a key at https://www.zotero.org/settings/keys (library read access is sufficient)
# ZOTERO_USER_ID=your_zotero_user_id_here
# ZOTERO_API_KEY=your_zotero_api_key_here
# ZOTERO_COLLECTION=name_of_collection_to_sync

# Google API credentials
# Create .google_api_key file in Rails root with your API key
# or set GOOGLE_API_KEY environment variable

# LanguageLayer API credentials  
# Create .languagelayer_api_key file in Rails root with your API key
# or set LANGUAGELAYER_API_KEY environment variable

# Database configuration (if needed)
# DATABASE_URL=sqlite3://db/production.sqlite3

# Rails configuration
RAILS_ENV=production
SECRET_KEY_BASE=generate_a_secure_random_key_here